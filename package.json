{
    "name": "claro-de-luna",
    "version": "0.1.0",
    "private": true,
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "shared:build": "npm run build -w @claro-de-luna/shared",
        "api:prisma:generate": "npm run prisma:generate -w @claro-de-luna/api",
        "build": "npm run shared:build && npm run build -w @claro-de-luna/api",
        "start": "npm run start:prod -w @claro-de-luna/api"
    },
    "devDependencies": {
        "prettier": "^3.4.2",
        "typescript": "~6.0.3"
    }
}
