generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  name          String?
  role          UserRole       @default(guest)
  createdAt     DateTime       @default(now())
  reservations  Reservation[]
  deviceTokens  DeviceToken[]
  refreshTokens RefreshToken[]
}

enum UserRole {
  guest
  qa
  admin
}

// Singleton row holding the active 4-digit entrance code (Feature 05).
// Rotates weekly (regenerated on read after 7 days) or when an admin regenerates it.
model EntranceCode {
  id        String   @id @default(uuid())
  code      String
  updatedAt DateTime @default(now())
}

model OtpCode {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([email])
}

model Reservation {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  date      DateTime          @db.Date
  time      String
  partySize Int
  status    ReservationStatus @default(pending)
  createdAt DateTime          @default(now())
  checkIn   CheckIn?
  milestones ItineraryMilestone[]
}

model ItineraryMilestone {
  id            String      @id @default(uuid())
  reservationId String
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  order         Int
  time          String
  name          String
  description   String
  x             Float
  y             Float
  createdAt     DateTime    @default(now())

  @@index([reservationId])
}

model CheckIn {
  id            String      @id @default(uuid())
  reservationId String      @unique
  reservation   Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  userId        String
  checkedInAt   DateTime    @default(now())
}

model DeviceToken {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  expoPushToken String   @unique
  platform      String
  createdAt     DateTime @default(now())
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum ReservationStatus {
  pending
  confirmed
  completed
  no_show
}

// --- Content: admin-managed menu and garden (Feature 06) ---

model MenuSection {
  id        String     @id @default(uuid())
  title     String
  order     Int        @default(0)
  items     MenuItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model MenuItem {
  id          String      @id @default(uuid())
  sectionId   String
  section     MenuSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  name        String
  description String
  imageUrl    String?
  tags        String[]
  order       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([sectionId])
}

model GardenSection {
  id        String   @id @default(uuid())
  title     String
  body      String
  imageUrl  String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GuideQuestion {
  id        String   @id @default(uuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
