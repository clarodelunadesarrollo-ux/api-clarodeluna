NODE_ENV=development
PORT=3000

# Neon Postgres connection string (get it from your Neon project dashboard)
# For local development you can use Docker Compose instead:
#   docker compose up -d
#   DATABASE_URL="postgresql://claro:claro@localhost:5432/claro_de_luna?schema=public"
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# JWT secrets — generate strong random values for production
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Resend API key for OTP emails (https://resend.com).
# If left empty, the OTP code is printed to the API logs (dev only).
RESEND_API_KEY=""
MAIL_FROM="Claro de Luna <onboarding@resend.dev>"

# Set to "true" ONLY for closed demos without email delivery: returns the OTP
# code in the request-otp response so the app auto-fills/notifies it.
# INSECURE for real users (any account's code becomes readable). Keep off in prod.
OTP_EXPOSE_CODE="false"
